# Reference only. Frappe does not automatically load this file.
# Configure secrets in the Frappe site's site_config.json or deployment
# secret manager; never commit live credentials.

# Configure the nested "gemini" object in site_config.json; see docs/DEVELOPMENT.md.
GEMINI_API_KEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
