# Configure a nested "mpesa" object in site_config.json; see docs/DEVELOPMENT.md.
# This file is not loaded by the application.
MPESA_ENVIRONMENT=Sandbox
MPESA_CALLBACK_URL=
# Reference values only; configure the nested fulfillment_notifications object
# in site_config.json as described in docs/DEVELOPMENT.md.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
MAPS_API_KEY=
