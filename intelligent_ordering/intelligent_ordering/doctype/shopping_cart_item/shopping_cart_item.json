{
  "doctype": "DocType",
  "name": "Shopping Cart Item",
  "module": "Intelligent Ordering",
  "istable": 1,
  "engine": "InnoDB",
  "field_order": ["product", "quantity", "currency", "unit_price", "subtotal"],
  "fields": [
    {"fieldname": "product", "fieldtype": "Link", "label": "Product", "options": "Product", "reqd": 1, "in_list_view": 1},
    {"default": "1", "fieldname": "quantity", "fieldtype": "Int", "label": "Quantity", "reqd": 1, "in_list_view": 1},
    {"default": "KES", "fieldname": "currency", "fieldtype": "Data", "label": "Currency", "hidden": 1},
    {"default": "0", "fieldname": "unit_price", "fieldtype": "Currency", "label": "Unit Price", "options": "currency", "read_only": 1, "in_list_view": 1},
    {"default": "0", "fieldname": "subtotal", "fieldtype": "Currency", "label": "Subtotal", "options": "currency", "read_only": 1, "in_list_view": 1}
  ],
  "permissions": []
}
