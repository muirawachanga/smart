{
  "doctype": "DocType",
  "name": "Sales Order Item",
  "module": "Intelligent Ordering",
  "istable": 1,
  "engine": "InnoDB",
  "field_order": ["product", "product_name_snapshot", "product_sku_snapshot", "product_category_snapshot", "quantity", "currency", "unit_price", "line_total"],
  "fields": [
    {"fieldname": "product", "fieldtype": "Link", "label": "Product", "options": "Product", "reqd": 1, "read_only": 1},
    {"fieldname": "product_name_snapshot", "fieldtype": "Data", "label": "Product Name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "product_sku_snapshot", "fieldtype": "Data", "label": "SKU", "read_only": 1},
    {"fieldname": "product_category_snapshot", "fieldtype": "Data", "label": "Category at Order Time", "read_only": 1},
    {"fieldname": "quantity", "fieldtype": "Float", "label": "Quantity", "reqd": 1, "default": "1", "read_only": 1, "in_list_view": 1},
    {"default": "KES", "fieldname": "currency", "fieldtype": "Data", "label": "Currency", "hidden": 1},
    {"fieldname": "unit_price", "fieldtype": "Currency", "label": "Unit Price", "options": "currency", "reqd": 1, "default": "0", "read_only": 1},
    {"fieldname": "line_total", "fieldtype": "Currency", "label": "Line Total", "options": "currency", "reqd": 1, "default": "0", "read_only": 1, "in_list_view": 1}
  ],
  "permissions": []
}
