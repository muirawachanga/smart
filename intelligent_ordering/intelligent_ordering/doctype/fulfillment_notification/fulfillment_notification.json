{
  "doctype": "DocType",
  "name": "Fulfillment Notification",
  "module": "Intelligent Ordering",
  "autoname": "hash",
  "engine": "InnoDB",
  "field_order": ["event_key", "event_type", "order", "delivery", "recipient_phone", "recipient_user", "provider", "sms_environment", "status", "attempts", "attempted_at", "provider_message_id", "last_error", "payload"],
  "fields": [
    {"fieldname": "event_key", "fieldtype": "Data", "label": "Event Key", "unique": 1, "reqd": 1, "read_only": 1},
    {"fieldname": "event_type", "fieldtype": "Data", "label": "Event", "read_only": 1, "in_list_view": 1},
    {"fieldname": "order", "fieldtype": "Link", "options": "Sales Order", "label": "Order", "read_only": 1},
    {"fieldname": "delivery", "fieldtype": "Link", "options": "Delivery", "label": "Delivery", "read_only": 1},
    {"fieldname": "recipient_phone", "fieldtype": "Data", "label": "Customer Phone", "read_only": 1},
    {"fieldname": "recipient_user", "fieldtype": "Link", "options": "User", "label": "Assigned User", "read_only": 1},
    {"fieldname": "provider", "fieldtype": "Data", "label": "Configured Provider", "read_only": 1},
    {"fieldname": "sms_environment", "fieldtype": "Data", "label": "SMS Environment", "read_only": 1},
    {"fieldname": "status", "fieldtype": "Select", "options": "Prepared\nSending\nSubmitted\nFailed\nUnknown", "default": "Prepared", "label": "Submission Status", "read_only": 1, "in_list_view": 1},
    {"fieldname": "attempts", "fieldtype": "Int", "label": "Attempts", "read_only": 1},
    {"fieldname": "attempted_at", "fieldtype": "Datetime", "label": "Last Attempt", "read_only": 1},
    {"fieldname": "provider_message_id", "fieldtype": "Data", "label": "Provider Message ID", "read_only": 1},
    {"fieldname": "last_error", "fieldtype": "Small Text", "label": "Submission Detail", "read_only": 1},
    {"fieldname": "payload", "fieldtype": "Code", "options": "JSON", "label": "Event Payload", "read_only": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1},
    {"role": "Business Admin", "read": 1},
    {"role": "Order Manager", "read": 1}
  ]
}
