{
  "doctype": "DocType",
  "name": "Customer Profile",
  "module": "Intelligent Ordering",
  "autoname": "field:user",
  "engine": "InnoDB",
  "field_order": ["user", "full_name", "phone", "enabled", "contact_verification_required", "verified_email", "email_verified_at", "verified_phone", "phone_verified_at"],
  "fields": [
    {"fieldname": "user", "fieldtype": "Link", "label": "User", "options": "User", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "full_name", "fieldtype": "Data", "label": "Full Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "phone", "fieldtype": "Data", "label": "Phone"},
    {"default": "1", "fieldname": "enabled", "fieldtype": "Check", "label": "Enabled"},
    {"default": "0", "fieldname": "contact_verification_required", "fieldtype": "Check", "label": "Require verified contacts for ordering", "read_only": 1},
    {"fieldname": "verified_email", "fieldtype": "Data", "label": "Verified email", "read_only": 1},
    {"fieldname": "email_verified_at", "fieldtype": "Datetime", "label": "Email verified at", "read_only": 1},
    {"fieldname": "verified_phone", "fieldtype": "Data", "label": "Verified phone", "read_only": 1},
    {"fieldname": "phone_verified_at", "fieldtype": "Datetime", "label": "Phone verified at", "read_only": 1}
  ],
  "permissions": [
    {"role": "Customer", "read": 1},
    {"role": "Business Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Store Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Order Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Inventory Manager", "read": 1},
    {"role": "Customer Support", "read": 1}
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1
}
