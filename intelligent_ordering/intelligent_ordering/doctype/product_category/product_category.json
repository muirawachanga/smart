{
  "doctype": "DocType",
  "name": "Product Category",
  "module": "Intelligent Ordering",
  "autoname": "field:category_name",
  "engine": "InnoDB",
  "field_order": ["category_name", "description", "enabled"],
  "fields": [
    {"fieldname": "category_name", "fieldtype": "Data", "label": "Category Name", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
    {"default": "1", "fieldname": "enabled", "fieldtype": "Check", "label": "Enabled"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Customer", "read": 1},
    {"role": "Business Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Store Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Order Manager", "read": 1},
    {"role": "Inventory Manager", "read": 1},
    {"role": "Delivery Staff", "read": 1}
  ],
  "sort_field": "category_name",
  "sort_order": "ASC",
  "track_changes": 1
}
