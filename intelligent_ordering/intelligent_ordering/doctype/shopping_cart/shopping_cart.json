{
  "doctype": "DocType",
  "name": "Shopping Cart",
  "module": "Intelligent Ordering",
  "autoname": "field:user",
  "engine": "InnoDB",
  "field_order": ["user", "items", "currency", "total"],
  "fields": [
    {"fieldname": "user", "fieldtype": "Link", "label": "User", "options": "User", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "items", "fieldtype": "Table", "label": "Items", "options": "Shopping Cart Item"},
    {"default": "KES", "fieldname": "currency", "fieldtype": "Data", "label": "Currency", "read_only": 1},
    {"default": "0", "fieldname": "total", "fieldtype": "Currency", "label": "Total", "options": "currency", "read_only": 1}
  ],
  "permissions": [
    {"role": "Customer", "read": 1, "write": 1, "create": 1}
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1
}
