  "fields": [
    {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Customer Profile", "reqd": 1, "in_list_view": 1},
    {"fieldname": "address_label", "fieldtype": "Data", "label": "Address Label"},
    {"fieldname": "address_line_1", "fieldtype": "Data", "label": "Address Line 1", "reqd": 1},
    {"fieldname": "address_line_2", "fieldtype": "Data", "label": "Address Line 2"},
    {"fieldname": "city", "fieldtype": "Data", "label": "City", "reqd": 1, "in_list_view": 1},
    {"fieldname": "region", "fieldtype": "Data", "label": "Region"},
    {"fieldname": "postal_code", "fieldtype": "Data", "label": "Postal Code"},
    {"default": "0", "fieldname": "is_default", "fieldtype": "Check", "label": "Default Address"}
